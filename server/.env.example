# Project Settings > Data API  -> Project URL
SUPABASE_URL=
# Project Settings > API Keys  -> anon public key
SUPABASE_KEY=
PORT=3000
# Origin frontend yang boleh akses, pisahkan dengan koma. Kosong = semua origin.
# Contoh: http://localhost:5173,https://username.github.io
CORS_ORIGIN=http://localhost:5173
